{
  "apps": [
    {
      "name": "Demo Server",
      "script": "npm",
      "watch": false,
      "instances": "1",
      "exec_mode": "fork",
      "args": "run dev",
      "env": {
        "NODE_ENV": "development"
      },
      "env_production": {
        "NODE_ENV": "production"
      },
      "error_file": "logs/err.log",
      "out_file": "logs/out.log",
      "log_file": "logs/combined.log",
      "time": true
    }
  ]
}
