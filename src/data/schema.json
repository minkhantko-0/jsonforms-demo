{
  "type": "object",
  "properties": {
    "requiresApproval": {
      "type": "boolean",
      "title": "Requires Approval Workflow",
      "default": false
    },
    "workflowId": {
      "type": "string",
      "title": "Workflow ID"
    },
    "filePicker": {
      "type": "string",
      "format": "data-url",
      "title": "Upload Document",
      "maxLength": 5242880,
      "pattern": ".*\\.csv$",
      "errorMessage": {
        "pattern": "Only CSV files are allowed",
        "maxLength": "File size must be less than 5MB"
      }
    }
  },
  "required": ["filePicker"],
  "errorMessage": {
    "required": {
      "filePicker": "File upload is required"
    }
  }
}
