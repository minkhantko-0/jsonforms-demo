{
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "Title",
      "minLength": 3,
      "maxLength": 100
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "date": {
      "type": "string",
      "format": "date",
      "title": "Date"
    },
    "dueDate": {
      "type": "string",
      "format": "date",
      "title": "Due Date"
    },
    "email": {
      "type": "string",
      "format": "email",
      "title": "Email Address"
    },
    "phone": {
      "type": "string",
      "title": "Phone Number",
      "pattern": "^[0-9\\-\\+\\(\\)\\s]+$"
    },
    "priority": {
      "type": "string",
      "title": "Priority",
      "enum": ["Low", "Medium", "High", "Critical"],
      "default": "Medium"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": ["Draft", "Pending", "In Progress", "Completed"],
      "default": "Draft"
    },
    "amount": {
      "type": "number",
      "title": "Amount",
      "minimum": 0,
      "errorMessage": {
        "minimum": "Amount must be a non-negative number"
      }
    },
    "requiresApproval": {
      "type": "boolean",
      "title": "Requires Approval Workflow",
      "default": false
    },
    "workflowId": {
      "type": "string",
      "title": "Workflow ID"
    },
    "filePicker": {
      "type": "string",
      "format": "data-url",
      "title": "Upload Document",
      "maxLength": 5242880,
      "pattern": ".*\\.csv$",
      "errorMessage": {
        "pattern": "Only CSV files are allowed",
        "maxLength": "File size must be less than 5MB"
      }
    }
  },
  "required": ["title", "filePicker", "amount"],
  "errorMessage": {
    "required": {
      "title": "Title is required",
      "filePicker": "File upload is required",
      "amount": "Amount is required"
    }
  }
}
